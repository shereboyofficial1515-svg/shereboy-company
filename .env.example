# Google Gemini (Google AI Studio > Get API Key)
GEMINI_API_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Sessions
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Admin login (see README "Create the first admin account")
ADMIN_USERNAME=GENERATE_A_LONG_RANDOM_SECRET
ADMIN_PASSWORD_HASH=GENERATE_A_LONG_RANDOM_SECRET

# Social placeholders (safe to leave until you have real links)
