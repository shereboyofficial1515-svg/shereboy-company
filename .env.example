# ============================================
# SHEREBOY TECH LTD — Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file.
# ============================================

# Server
PORT=10000
NODE_ENV=production

# Supabase (Project Settings > API)
SUPABASE_URL=GENERATE_A_LONG_RANDOM_SECRET
SUPABASE_SERVICE_ROLE_KEY=GENERATE_A_LONG_RANDOM_SECRET
SUPABASE_STORAGE_BUCKET=sheroboy
# Optional PRIVATE bucket for admin-only documents (create it in Supabase as NOT public)
SUPABASE_PRIVATE_BUCKET=sheroboytech-private
GEMINI_MODEL=GENERATE_A_LONG_RANDOM_SECRET

# Google Gemini (Google AI Studio > Get API Key)
GEMINI_API_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Public site address (absolute URLs in the sitemap, canonical tags and the
# live-preview embedding check). Comma-separate if you serve more than one domain.
SITE_URL=https://shereboytechltd.site

# SHEREBOY BLOG integration (articles in the Insights section come from the blog)
BLOG_API_BASE_URL=https://shereblog-news.onrender.com
BLOG_PUBLIC_URL=https://shereblog-news.onrender.com
# Shared secret for the blog's "content changed" webhook — must equal
# COMPANY_SITE_WEBHOOK_SECRET on SHEREBOY BLOG. Generate with: openssl rand -hex 32
BLOG_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# Optional tuning (defaults shown)
BLOG_CACHE_TTL_SECONDS=300
BLOG_STALE_MAX_SECONDS=21600
BLOG_FETCH_TIMEOUT_MS=10000
BLOG_REFRESH_INTERVAL_SECONDS=900
BLOG_FEED_SIZE=7

# SHEREBOY AFFILIATE CONCEPT integration (Affiliate Product page + homepage Featured Products)
AFFILIATE_API_BASE_URL=https://shereboyaffiliateconcept.shop
AFFILIATE_PUBLIC_URL=https://shereboyaffiliateconcept.shop
# Must equal COMPANY_SITE_WEBHOOK_SECRET on the affiliate platform. Generate with: openssl rand -hex 32
AFFILIATE_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# Optional tuning (defaults shown)
AFFILIATE_CACHE_TTL_SECONDS=300
AFFILIATE_STALE_MAX_SECONDS=21600
AFFILIATE_FETCH_TIMEOUT_MS=10000
AFFILIATE_REFRESH_INTERVAL_SECONDS=900
# Only needed if another domain must call this API with cookies (normally leave empty)
ALLOWED_ORIGINS=

# Sessions
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Email (Resend). Server-side only. See README section 17.
RESEND_API_KEY=GENERATE_IN_THE_RESEND_DASHBOARD
RESEND_FROM_EMAIL=SHEREBOY TECH LTD <support@shereboytechltd.site>
RESEND_REPLY_TO=support@shereboytechltd.site
# The signing secret from your Resend webhook (starts with whsec_)
RESEND_WEBHOOK_SECRET=
# Optional: the Resend segment (formerly "audience") for confirmed subscribers
RESEND_SEGMENT_ID=
# The address used in confirmation and unsubscribe links
APP_BASE_URL=https://shereboytechltd.site
# Signs unsubscribe links. Keep it stable: changing it breaks links in sent emails.
# Generate with: openssl rand -hex 32
EMAIL_TOKEN_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# Optional: lets an outside scheduler wake the site for scheduled campaigns
EMAIL_CRON_SECRET=
# Optional tuning (defaults shown)
EMAIL_BATCH_SIZE=50
EMAIL_WORKER_INTERVAL_MS=1500
EMAIL_INDIVIDUAL_MAX_RECIPIENTS=10
EMAIL_INDIVIDUAL_DAILY_LIMIT=50
EMAIL_LARGE_AUDIENCE_THRESHOLD=25
EMAIL_TEST_HOURLY_LIMIT=20

# Google Search Console: the "content" value of the HTML-tag verification method.
# Leave empty until Search Console gives you a value.
GOOGLE_SITE_VERIFICATION=

# Connected-service wake-up (defaults shown)
SERVICE_ATTEMPT_TIMEOUT_SECONDS=20
SERVICE_WAKE_WINDOW_SECONDS=120
SERVICE_BACKOFF_BASE_MS=2000
SERVICE_BACKOFF_MAX_MS=30000
SERVICE_HEALTH_CACHE_SECONDS=60
SERVICE_DOWN_COOLDOWN_SECONDS=120
SERVICE_ACTIVE_VISITOR_MINUTES=20

# Admin login (see README "Create the first admin account")
ADMIN_USERNAME=GENERATE_A_LONG_RANDOM_SECRET
ADMIN_PASSWORD_HASH=GENERATE_A_LONG_RANDOM_SECRET

# Social placeholders (safe to leave until you have real links)
INSTAGRAM_URL=passowrd
TIKTOK_URL=tiktok.com/@shereboy
YOUTUBE_URL=https://youtube.com/@shereboytech1379?si=fuCdBXWuOhccDAYt
